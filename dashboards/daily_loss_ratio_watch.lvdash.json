{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Kpi",
      "queryLines": [
        "SELECT MEASURE(loss_ratio) AS ytd_loss_ratio, MEASURE(target_loss_ratio) AS ytd_target, MEASURE(combined_ratio) AS ytd_combined_ratio, MEASURE(loss_ratio_vs_target_pts) AS ytd_gap_pts, (SELECT COUNT(*) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.v_loss_ratio_watchlist WHERE status = 'RED') AS red_segments, (SELECT COUNT(*) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.v_loss_ratio_watchlist WHERE status = 'AMBER') AS amber_segments FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.mv_loss_ratio WHERE YEAR(as_of_date) = YEAR((SELECT MAX(as_of_date) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.gold_daily_loss_run)) "
      ]
    },
    {
      "name": "trend",
      "displayName": "Trend",
      "queryLines": [
        "WITH d AS (SELECT as_of_date, line_of_business, SUM(incurred_loss) inc, SUM(earned_premium) ep FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.gold_daily_loss_run GROUP BY ALL) SELECT as_of_date, line_of_business, SUM(inc) OVER w / SUM(ep) OVER w AS rolling_7d_loss_ratio FROM d WHERE as_of_date >= (SELECT MAX(as_of_date) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.gold_daily_loss_run) - INTERVAL 120 DAYS WINDOW w AS (PARTITION BY line_of_business ORDER BY as_of_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) "
      ]
    },
    {
      "name": "lob_vs_target",
      "displayName": "Lob Vs Target",
      "queryLines": [
        "SELECT line_of_business, 'Actual (30 days)' AS measure, MEASURE(loss_ratio) AS value FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.mv_loss_ratio WHERE as_of_date > (SELECT MAX(as_of_date) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.gold_daily_loss_run) - INTERVAL 30 DAYS GROUP BY line_of_business UNION ALL SELECT line_of_business, 'Target', MEASURE(target_loss_ratio) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.mv_loss_ratio WHERE as_of_date > (SELECT MAX(as_of_date) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.gold_daily_loss_run) - INTERVAL 30 DAYS GROUP BY line_of_business "
      ]
    },
    {
      "name": "watchlist",
      "displayName": "Watchlist",
      "queryLines": [
        "SELECT status, line_of_business, region, primary_driver, ROUND(lr_7d * 100, 1) AS lr_7d_pct, ROUND(lr_30d * 100, 1) AS lr_30d_pct, ROUND(target_loss_ratio * 100, 1) AS target_pct, gap_7d_pts, ROUND(freq_change * 100, 0) AS freq_change_pct, ROUND(sev_change * 100, 0) AS sev_change_pct, large_losses_7d, owner_team FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.v_loss_ratio_watchlist ORDER BY CASE status WHEN 'RED' THEN 0 WHEN 'AMBER' THEN 1 ELSE 2 END, gap_7d_pts DESC "
      ]
    },
    {
      "name": "actions",
      "displayName": "Actions",
      "queryLines": [
        "SELECT a.priority, a.team, al.line_of_business, al.region, al.primary_driver, a.action, a.due_within, a.state FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.lr_action_recommendations a JOIN serverless_stable_xhky6g_catalog.loss_ratio_coworker.lr_alerts al USING (alert_id) WHERE al.as_of_date = (SELECT MAX(as_of_date) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.lr_alerts) QUALIFY ROW_NUMBER() OVER (PARTITION BY a.alert_id, a.team ORDER BY a.created_at DESC) = 1 ORDER BY a.priority, a.team "
      ]
    },
    {
      "name": "benchmarks",
      "displayName": "Benchmarks",
      "queryLines": [
        "SELECT 'Our book (YTD, synthetic)' AS benchmark, MEASURE(combined_ratio) AS combined_ratio FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.mv_loss_ratio WHERE YEAR(as_of_date) = YEAR((SELECT MAX(as_of_date) FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.gold_daily_loss_run)) UNION ALL SELECT CONCAT(benchmark, ' ', period, IF(basis LIKE '%undiscounted%', ' (undiscounted)', '')), value FROM serverless_stable_xhky6g_catalog.loss_ratio_coworker.industry_benchmarks "
      ]
    }
  ],
